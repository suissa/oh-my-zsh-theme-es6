{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "console_title_template": "{{ .Folder }}",
  "transient_prompt": {
    "template": "➜ ",
    "foreground": "#98c379"
  },
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "type": "venv",
          "style": "plain",
          "foreground": "#61afef",
          "template": "({{ .Name }}) ",
          "properties": {
            "cache_duration": "none"
          }
        },
        {
          "type": "path",
          "style": "plain",
          "foreground": "#c678dd",
          "template": "({{ .Folder }}) ",
          "properties": {
            "cache_duration": "none",
            "style": "folder"
          }
        },
        {
          "type": "status",
          "style": "plain",
          "foreground": "#98c379",
          "foreground_templates": [
            "{{ if gt .Code 0 }}#e06c75{{ end }}"
          ],
          "template": "{{ if eq .Code 0 }}➜{{ else }}✗{{ end }} ",
          "properties": {
            "always_enabled": true,
            "display_exit_code": false
          }
        },
        {
          "type": "git",
          "style": "plain",
          "foreground": "#e06c75",
          "template": "{{ if .HEAD }}(git:( {{ .HEAD }}{{ if .Working.Changed }} ✗{{ else }} ✓{{ end }} )){{ end }} ",
          "properties": {
            "branch_icon": " ",
            "display_status": false,
            "display_stash_count": false,
            "display_upstream_icon": false,
            "fetch_stash_count": false
          }
        },
        {
          "type": "text",
          "style": "plain",
          "foreground": "#ffffff",
          "template": "➜ ",
          "properties": {
            "cache_duration": "none"
          }
        }
      ]
    }
  ],
  "final_space": true,
  "version": 3
}
