{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "final_space": true,
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "type": "path",
          "style": "plain",
          "foreground": "magenta",
          "properties": {
            "style": "folder",
            "max_depth": 2
          }
        },
        {
          "type": "git",
          "style": "plain",
          "foreground": "red",
          "properties": {
            "prefix": " git:(",
            "suffix": ")",
            "branch_icon": "",
            "display_status": true,
            "display_stash_count": false,
            "display_upstream_icon": false
          }
        },
        {
          "type": "status",
          "style": "plain",
          "foreground": "green",
          "background": "",
          "properties": {
            "always_enabled": true,
            "ok_icon": "➜",
            "error_icon": "➜",
            "display_exit_code": false
          },
          "templates": {
            "success": "{{ .OkIcon }}",
            "failure": "{{ .ErrorIcon }}"
          }
        }
      ]
    }
  ],
  "transient_prompt": {
    "template": "{{ .Folder }} ",
    "foreground": "magenta"
  },
  "version": 2
}
